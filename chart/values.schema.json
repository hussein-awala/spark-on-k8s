{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "spark-on-k8s chart values",
  "type": "object",
  "description": "Validates chart-managed controls; Kubernetes passthrough objects and extension keys remain open.",
  "required": [
    "rbac",
    "runHistory",
    "metrics"
  ],
  "definitions": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s@]+/[^\\s@:]+$|^[^\\s@:]+$"
        },
        "tag": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-fA-F0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "automount": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "targetMemoryUtilizationPercentage": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "targetCPUUtilizationPercentage": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "targetCPUUtilizationPercentage"
                ]
              },
              {
                "properties": {
                  "targetMemoryUtilizationPercentage": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "targetMemoryUtilizationPercentage"
                ]
              }
            ]
          }
        }
      ]
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "disruptionLimit": {
      "type": [
        "integer",
        "string",
        "null"
      ],
      "minimum": 0,
      "pattern": "^([0-9]|[1-9][0-9]|100)%$",
      "description": "A pod count, a percentage such as \"50%\", or null."
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "$ref": "#/definitions/disruptionLimit"
        },
        "maxUnavailable": {
          "$ref": "#/definitions/disruptionLimit"
        }
      },
      "if": {
        "properties": {
          "minAvailable": {
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "required": [
          "minAvailable"
        ]
      },
      "then": {
        "properties": {
          "maxUnavailable": {
            "type": "null",
            "description": "Set either minAvailable or maxUnavailable, not both."
          }
        }
      }
    },
    "networkPeers": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Kubernetes NetworkPolicyPeer objects."
    },
    "probe": {
      "type": [
        "object",
        "null"
      ],
      "description": "A Kubernetes Probe, or null to remove it."
    }
  },
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "workers": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 64,
      "description": "API worker processes per pod; null keeps the image default."
    },
    "image": {
      "$ref": "#/definitions/image"
    },
    "serviceAccount": {
      "$ref": "#/definitions/serviceAccount"
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "legacyNames": {
          "type": "boolean"
        },
        "allowClusterWideWrite": {
          "type": "boolean",
          "description": "Acknowledges that namespaces \"*\" with readOnly false grants pod create, delete and exec in every namespace."
        }
      }
    },
    "service": {
      "$ref": "#/definitions/service"
    },
    "autoscaling": {
      "$ref": "#/definitions/autoscaling"
    },
    "namespaces": {
      "type": "string",
      "pattern": "^(|\\*| *[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])? *(, *[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])? *)*)$",
      "description": "Empty for the release namespace, a wildcard, or comma-separated Kubernetes namespaces; not a YAML list."
    },
    "readOnly": {
      "type": "boolean"
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^$|^(0|(([0-9]+)y)?(([0-9]+)w)?(([0-9]+)d)?(([0-9]+)h)?(([0-9]+)m)?(([0-9]+)s)?(([0-9]+)ms)?)$"
            },
            "scrapeTimeout": {
              "type": "string",
              "pattern": "^$|^(0|(([0-9]+)y)?(([0-9]+)w)?(([0-9]+)d)?(([0-9]+)h)?(([0-9]+)m)?(([0-9]+)s)?(([0-9]+)ms)?)$"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "serviceMonitor": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          }
        },
        "required": [
          "serviceMonitor"
        ]
      },
      "then": {
        "properties": {
          "enabled": {
            "const": true,
            "description": "metrics.serviceMonitor requires metrics.enabled."
          }
        },
        "required": [
          "enabled"
        ]
      }
    },
    "runHistory": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespaces": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
          }
        },
        "existingClaim": {
          "type": "string"
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 3600
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "maxRows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "sparkHistory": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "$ref": "#/definitions/image"
        },
        "serviceAccount": {
          "$ref": "#/definitions/serviceAccount"
        },
        "service": {
          "$ref": "#/definitions/service"
        },
        "autoscaling": {
          "$ref": "#/definitions/autoscaling"
        },
        "configuration": {
          "type": "string"
        },
        "readinessProbe": {
          "$ref": "#/definitions/probe"
        },
        "livenessProbe": {
          "$ref": "#/definitions/probe"
        },
        "podDisruptionBudget": {
          "$ref": "#/definitions/podDisruptionBudget"
        },
        "networkPolicy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "ingress": {
              "type": "object",
              "properties": {
                "from": {
                  "$ref": "#/definitions/networkPeers"
                }
              }
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "affinity": {
          "type": "object"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "volumeMounts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tolerations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "pathType"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^/"
                    },
                    "pathType": {
                      "enum": [
                        "Exact",
                        "Prefix",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "affinity": {
      "type": "object"
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "volumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "podDisruptionBudget": {
      "$ref": "#/definitions/podDisruptionBudget"
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/definitions/networkPeers"
            }
          }
        },
        "egress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "kubernetesApi": {
              "type": "object",
              "properties": {
                "to": {
                  "$ref": "#/definitions/networkPeers"
                },
                "ports": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            },
            "dns": {
              "type": "object",
              "properties": {
                "to": {
                  "$ref": "#/definitions/networkPeers"
                }
              }
            },
            "extraRules": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "remote": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]{0,251}[a-z0-9])?$"
        },
        "tokenKey": {
          "type": "string",
          "pattern": "^[-._a-zA-Z0-9]{1,253}$"
        },
        "policyKey": {
          "type": "string",
          "pattern": "^[-._a-zA-Z0-9]{1,253}$"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^(/[^/\\s]+)+$"
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "existingSecret": {
            "minLength": 1
          }
        },
        "required": [
          "existingSecret"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "runHistory": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          }
        },
        "required": [
          "runHistory"
        ]
      },
      "then": {
        "properties": {
          "replicaCount": {
            "const": 1
          },
          "autoscaling": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          },
          "runHistory": {
            "properties": {
              "namespaces": {
                "minItems": 1
              },
              "existingClaim": {
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sparkHistory": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          }
        },
        "required": [
          "sparkHistory"
        ]
      },
      "then": {
        "properties": {
          "sparkHistory": {
            "properties": {
              "image": {
                "anyOf": [
                  {
                    "properties": {
                      "tag": {
                        "minLength": 1
                      }
                    },
                    "required": [
                      "tag"
                    ]
                  },
                  {
                    "properties": {
                      "digest": {
                        "minLength": 1
                      }
                    },
                    "required": [
                      "digest"
                    ]
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "rbac": {
            "properties": {
              "create": {
                "const": true
              }
            },
            "required": [
              "create"
            ]
          },
          "serviceAccount": {
            "properties": {
              "create": {
                "const": false
              }
            },
            "required": [
              "create"
            ]
          }
        },
        "required": [
          "rbac",
          "serviceAccount"
        ]
      },
      "then": {
        "properties": {
          "serviceAccount": {
            "properties": {
              "name": {
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "name"
            ]
          }
        }
      }
    }
  ]
}
